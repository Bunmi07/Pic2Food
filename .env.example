OPENAI_API_KEY=
# Optional. Defaults shown.
OPENAI_VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT_SECONDS=15

# Recipe source (TheMealDB). "1" is the free development key; publishing
# publicly needs a supporter key.
MEALDB_API_KEY=1
RECIPE_TIMEOUT_SECONDS=8
RECIPE_MAX_LOOKUPS=25
# Supported match: missing at most RECIPE_MAX_MISSING ingredients (after
# pantry staples). Near match: up to RECIPE_MAX_MISSING + RECIPE_NEAR_MATCH_MARGIN.
RECIPE_MAX_MISSING=2
RECIPE_NEAR_MATCH_MARGIN=1
